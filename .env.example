# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# How to grab these from Chrome:
#   1. Sign in to https://fantasy.espn.com (any page)
#   2. DevTools (Cmd+Opt+I) > Application > Cookies > https://fantasy.espn.com
#   3. Copy the values of `SWID` and `espn_s2`
#
# SWID includes the curly braces, e.g. {ABCD1234-...-XYZ}
# espn_s2 is a long URL-encoded string

ESPN_LEAGUE_ID=2043154241
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=
