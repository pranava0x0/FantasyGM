# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# How to grab these from Chrome:
#   1. Sign in to https://fantasy.espn.com (any page)
#   2. DevTools (Cmd+Opt+I) > Application > Cookies > https://fantasy.espn.com
#   3. Copy the values of `SWID` and `espn_s2`
#
# SWID includes the curly braces, e.g. {ABCD1234-...-XYZ}
# espn_s2 is a long URL-encoded string

ESPN_LEAGUE_ID=2043154241
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=

# Twitter/X — optional HTTP fallback (primary path uses Chrome browser scraping).
# Only needed if the Chrome step can't run. All three values must be set together.
#
# TWITTER_BEARER: the X web-client bearer token (from DevTools → Network →
#   any x.com/i/api request → Authorization header, strip "Bearer ").
# TWITTER_AUTH_TOKEN + TWITTER_CT0: from DevTools → Application →
#   Cookies → https://x.com → auth_token and ct0.
TWITTER_BEARER=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
